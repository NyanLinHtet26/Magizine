@MagizinePublic.Api_HostAddress = http://localhost:5080

# The only route that currently responds: the OpenAPI document.
# It doubles as a liveness check - a 200 here means the app booted and, if the
# model builds, that the database wiring resolves. Add endpoint requests below
# as controllers are implemented.
GET {{MagizinePublic.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Fetch the list of active article categories
GET {{MagizinePublic.Api_HostAddress}}/api/public/article-category/list
Accept: application/json

###

# Fetch details of a specific article category by its slug
# Replace 'test-category' with an actual slug in your database
GET {{MagizinePublic.Api_HostAddress}}/api/public/article-category/test-category
Accept: application/json

###
